  "comparator": "exact",
  "time_limit_ms": 1000,
  "tests": [
    {"ordinal": 1, "is_sample": true,  "args": [[2, 7], 9], "expected": [0, 1]},
    {"ordinal": 2, "is_sample": false, "args": [[3, 4], 7],  "expected": [0, 1]},
