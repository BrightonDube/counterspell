# Never ignore .kiro (repository rule)
target/
node_modules/
web/build/
web/.svelte-kit/
.env
.env.*
!.env.example
*.pem
secrets/
.DS_Store

# Infrastructure state, variable files, inventories and keys (deploy-ops R1.5, R5.5)
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/.terraform/
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/ansible/inventory/hosts.yml
infra/ansible/inventory/group_vars/*secret*
*.agekey
*identity*.txt
rclone.conf
deploy/**/*.env
!deploy/**/*.env.example
.devin
# real-api harness runtime artifacts (server/judge logs, probes)
web/tests/real-api/.scratch/

# Editor and OS clutter (Windows/WSL downloads leave Zone.Identifier files)
.idea/
*.swp
Thumbs.db
desktop.ini
*:Zone.Identifier
*.Zone.Identifier

# Local tool workspace that holds no project source
.qodo/

# Coverage and profiling output (CI writes lcov.info at the repo root)
lcov.info
*.profraw
coverage/

# Terraform plan and crash output
*.tfplan
infra/**/crash.log

# Web test and build tool output
web/test-results/
web/playwright-report/
web/blob-report/
web/vite.config.js.timestamp-*
*.tsbuildinfo
npm-debug.log*
