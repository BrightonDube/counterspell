# Managed by Ansible (app role). The judge connects as cs_judge, a member of the NOLOGIN
# counterspell_judge group only: it cannot reach the auth tables.
DATABASE_URL=postgres://cs_judge:{{ vault_cs_judge_password }}@postgres:5432/counterspell
JUDGE_CONCURRENCY=2
LEASE_SECS=30
RENEW_SECS=10
LOG_FORMAT=json
