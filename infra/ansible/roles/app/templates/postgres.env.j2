# Managed by Ansible (app role). Secrets live only here, mode 0600, owner-only. Never commit
# real values: they come from the encrypted vault.yml. The initdb script in
# docker-entrypoint-initdb.d reads the CS_* passwords once at first initdb to create the
# per-service LOGIN roles.
POSTGRES_USER=counterspell
POSTGRES_DB=counterspell
POSTGRES_PASSWORD={{ vault_postgres_password }}
CS_SERVER_PASSWORD={{ vault_cs_server_password }}
CS_JUDGE_PASSWORD={{ vault_cs_judge_password }}
