# Managed by Ansible (app role). Secrets come from the encrypted vault.yml. With no mail provider
# configured the server starts with OAuth sign-in only (email sign-in is optional).
APP_ENV=production
PUBLIC_BASE_URL=https://{{ caddy_site_address }}
DATABASE_URL=postgres://cs_server:{{ vault_cs_server_password }}@postgres:5432/counterspell
VALKEY_URL=redis://valkey:6379
SESSION_SECRET={{ vault_session_secret }}
GITHUB_OAUTH_CLIENT_ID={{ vault_github_oauth_client_id | default('') }}
GITHUB_OAUTH_CLIENT_SECRET={{ vault_github_oauth_client_secret | default('') }}
GOOGLE_OAUTH_CLIENT_ID={{ vault_google_oauth_client_id | default('') }}
GOOGLE_OAUTH_CLIENT_SECRET={{ vault_google_oauth_client_secret | default('') }}
LOG_FORMAT=json
