# Managed by Ansible (app role). Non-secret host values only (deploy-ops R5.4). The deploy script
# copies this file into each release record. Secrets live in the service env files, never here.
CADDY_SITE_ADDRESS={{ caddy_site_address }}
TRUSTED_PROXIES={{ trusted_proxies }}
GHCR_OWNER={{ ghcr_owner | lower }}
SANDBOX_SOCKET_HOST_PATH=/run/user/{{ sandbox_uid }}/docker.sock
JUDGE_UID={{ judge_uid }}
LOG_FORMAT=json
COUNTERSPELL_SECRETS_DIR={{ app_env_dir }}
