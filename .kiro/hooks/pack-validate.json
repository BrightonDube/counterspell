{
  "version": "v1",
  "hooks": [
    {
      "name": "pack-validate",
      "description": "Validate only the changed Grimoire problem pack.",
      "trigger": "PostFileSave",
      "matcher": "packs/.*\\.(toml|json|py|rs)$",
      "action": {
        "type": "command",
        "command": "bash scripts/kiro-hooks/pack-validate.sh '{{filePath}}'"
      }
    }
  ]
}
