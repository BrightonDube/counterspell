{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "counterspell-mcp": {
      "type": "stdio",
      "command": "cargo",
      "args": [
        "run",
        "-q",
        "--release",
        "--manifest-path",
        "../Cargo.toml",
        "-p",
        "counterspell-mcp"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
