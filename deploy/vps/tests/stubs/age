#!/usr/bin/env bash
# Test stub for age. Records its arguments and fails when FAIL_AGE is set. It "encrypts" by base64,
# and "decrypts" (age -d) by base64 -d, so a test can check the plaintext marker never reaches disk.
echo "age $*" >> "${STUB_LOG:?}"
if [[ -n "${FAIL_AGE:-}" ]]; then exit 1; fi
if [[ "${1:-}" == "-d" ]]; then
  base64 -d
else
  base64
fi
exit 0
