#!/usr/bin/env bash
# Deploy script. Installed as <app bin dir>/counterspell-deploy. It runs as the deploy user: the
# app owner on the shared host (docker group, no sudo), root through sudo on a dedicated host.
# authorized_keys points the forced command here with no argv, so the request arrives in
# SSH_ORIGINAL_COMMAND and is parsed below; local runs pass the same verbs as argv. It validates
# the request again either way. Accepted verbs:
#   deploy <40-hex sha> <server digest> <judge digest> <migrate digest>
#   rollback
#   status
# Images are pulled by digest only. Compose files are checked against compose.sha256 before anything
# runs. Preflight and migrations run before the stack changes; if either fails, nothing changes.
# If readiness or the public health check fails after the stack changed, the previous release is
# restored. Migrations are never reversed (expand-only rule, RELEASE.md).
set -euo pipefail
umask 027

APP_DIR="${COUNTERSPELL_DIR:-/opt/counterspell}"
HOST_ENV="${COUNTERSPELL_HOST_ENV:-$APP_DIR/host.env}"
CURRENT="$APP_DIR/deploy.env"
PREVIOUS="$APP_DIR/deploy.env.previous"
CANDIDATE="$APP_DIR/deploy.env.new"
COMPOSE=(docker compose --project-directory "$APP_DIR" -f "$APP_DIR/docker-compose.yml" -f "$APP_DIR/compose.prod.yml")
# On the shared host the app role installs compose.shared.yml (no Caddy of its own, shared proxy network).
# It is covered by compose.sha256, so a changed or removed file is refused before any pull.
if [[ -f "$APP_DIR/compose.shared.yml" ]]; then
  COMPOSE+=(-f "$APP_DIR/compose.shared.yml")
fi

refuse() { echo "refused: $*" >&2; exit 2; }
fail() { echo "failed: $*" >&2; exit 1; }
log() { logger -t counterspell-deploy -- "$*" 2>/dev/null || true; echo "$*"; }

# Prints one value from host.env. Fails when the key is missing, so a bad host file stops a deploy.
host_value() {
  local value
  value="$(grep -m1 "^$1=" "$HOST_ENV" | cut -d= -f2- || true)"
  [[ -n "$value" ]] || fail "host.env has no $1"
  printf '%s' "$value"
}

# Runs docker compose with the env file given as $1 and the remaining arguments as the command.
dc() {
  local env_file="$1"
  shift
  "${COMPOSE[@]}" --env-file "$env_file" "$@"
}

# Stops with nothing changed on the host, and removes the candidate record.
abort_unchanged() {
  rm -f "$CANDIDATE"
  fail "$* (nothing changed)"
}

check_compose_files() {
  (cd "$APP_DIR" && sha256sum --check --quiet compose.sha256) \
    || refuse "compose files differ from compose.sha256; run the app role"
}

# Picks a container already attached to counterspell_edge to ask the server its readiness route.
# The shared proxy is always one (preferring *caddy* names); any edge member can reach the server.
edge_probe_container() {
  local names n
  names="$(docker network inspect counterspell_edge \
    -f '{{range .Containers}}{{.Name}} {{end}}' 2>/dev/null || true)"
  for n in $names; do case "$n" in *caddy*) printf '%s' "$n"; return 0 ;; esac; done
  for n in $names; do printf '%s' "$n"; return 0; done
  return 1
}

# Waits up to 60 s for the server's readiness route. The shared host runs no app Caddy (its service
# is profile-disabled), so there we ask from inside the counterspell_edge network via a container
# already attached to it. A dedicated host asks the app's own caddy service instead.
server_ready() {
  local env_file="$1" probe
  if [[ -f "$APP_DIR/compose.shared.yml" ]]; then
    probe="$(edge_probe_container)" || return 1
    for _ in $(seq 1 30); do
      if docker exec "$probe" wget -q -O /dev/null http://counterspell-server:8080/api/ready; then
        return 0
      fi
      sleep 2
    done
    return 1
  fi
  for _ in $(seq 1 30); do
    if dc "$env_file" exec -T caddy wget -q -O /dev/null http://server:8080/api/ready; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# Waits up to 60 s for the public health route over HTTPS. Set COUNTERSPELL_HEALTH_URL only in tests.
public_healthy() {
  local url body
  url="${COUNTERSPELL_HEALTH_URL:-https://$(host_value CADDY_SITE_ADDRESS)/api/health}"
  for _ in $(seq 1 30); do
    body="$(curl -fsS --max-time 5 "$url" || true)"
    if [[ "$body" == *'"ok"'* ]]; then
      return 0
    fi
    sleep 2
  done
  return 1
}

# Writes the candidate release record: the three digests plus a copy of host.env (R5.4).
write_candidate() {
  local sha="$1" d_server="$2" d_judge="$3" d_migrate="$4" owner
  owner="$(host_value GHCR_OWNER)"
  {
    echo "COUNTERSPELL_SHA=$sha"
    echo "COUNTERSPELL_SERVER_IMAGE=ghcr.io/$owner/counterspell-server@$d_server"
    echo "COUNTERSPELL_JUDGE_IMAGE=ghcr.io/$owner/counterspell-judge@$d_judge"
    echo "COUNTERSPELL_MIGRATE_IMAGE=ghcr.io/$owner/counterspell-migrate@$d_migrate"
    cat "$HOST_ENV"
  } > "$CANDIDATE"
}

# Makes the candidate the current release and keeps the old current record as previous.
promote() {
  if [[ -f "$CURRENT" ]]; then
    cp -p "$CURRENT" "$PREVIOUS"
  fi
  mv "$CANDIDATE" "$CURRENT"
}

# Restores the current release after a failed check, without touching migrations.
restore_current() {
  if [[ -f "$CURRENT" ]]; then
    local previous_sha
    previous_sha="$(grep '^COUNTERSPELL_SHA=' "$CURRENT" | cut -d= -f2)"
    if dc "$CURRENT" up -d --no-build --remove-orphans; then
      log "restored $previous_sha"
    else
      log "failed to restore $previous_sha"
    fi
  fi
  rm -f "$CANDIDATE"
}

deploy_release() {
  local sha="$1" d_server="$2" d_judge="$3" d_migrate="$4"
  write_candidate "$sha" "$d_server" "$d_judge" "$d_migrate"
  log "deploying $sha"

  dc "$CANDIDATE" pull server judge migrate || abort_unchanged "image pull failed"
  dc "$CANDIDATE" run --rm judge preflight || abort_unchanged "judge preflight failed"
  dc "$CANDIDATE" run --rm migrate || abort_unchanged "migration failed"

  if dc "$CANDIDATE" up -d --no-build --remove-orphans \
    && server_ready "$CANDIDATE" && public_healthy; then
    promote
    log "deployed $sha"
    exit 0
  fi

  log "checks failed for $sha; restoring the previous release"
  restore_current
  exit 1
}

rollback_release() {
  [[ -f "$PREVIOUS" ]] || refuse "no previous release record to roll back to"
  local previous_sha
  previous_sha="$(grep '^COUNTERSPELL_SHA=' "$PREVIOUS" | cut -d= -f2)"
  log "rolling back to $previous_sha"

  dc "$PREVIOUS" pull server judge || fail "image pull failed; release records unchanged"
  dc "$PREVIOUS" up -d --no-build --remove-orphans
  if server_ready "$PREVIOUS" && public_healthy; then
    local swap="$APP_DIR/deploy.env.swap"
    mv "$CURRENT" "$swap"
    mv "$PREVIOUS" "$CURRENT"
    mv "$swap" "$PREVIOUS"
    log "rolled back to $previous_sha"
    exit 0
  fi
  fail "rollback checks failed; release records unchanged"
}

show_status() {
  if [[ -f "$CURRENT" ]]; then
    grep -E '^COUNTERSPELL_(SHA|SERVER_IMAGE|JUDGE_IMAGE|MIGRATE_IMAGE)=' "$CURRENT"
  else
    echo "no deploy yet"
  fi
}

main() {
  local verb="${1:-}"
  local hex40='^[0-9a-f]{40}$'
  local digest='^sha256:[0-9a-f]{64}$'

  case "$verb" in
    status)
      [[ $# -eq 1 ]] || refuse "status takes no arguments"
      show_status
      exit 0
      ;;
    rollback)
      [[ $# -eq 1 ]] || refuse "rollback takes no arguments"
      ;;
    deploy)
      [[ $# -eq 5 ]] || refuse "expected 'deploy <sha> <digest> <digest> <digest>'"
      [[ "$2" =~ $hex40 ]] || refuse "sha must be 40 lowercase hex characters"
      [[ "$3" =~ $digest && "$4" =~ $digest && "$5" =~ $digest ]] || refuse "digests must be sha256:<64 hex>"
      ;;
    *)
      refuse "expected 'deploy', 'rollback' or 'status'"
      ;;
  esac

  exec 9>"$APP_DIR/.deploy.lock"
  flock -n 9 || refuse "another deploy is running"
  check_compose_files

  case "$verb" in
    deploy) deploy_release "$2" "$3" "$4" "$5" ;;
    rollback) rollback_release ;;
  esac
}

# Forced-command mode: authorized_keys runs this script with no argv and puts the client's
# request in SSH_ORIGINAL_COMMAND. Parse it into the argv the verbs expect. Explicit argv always
# wins, so local runs are unaffected. The verb grammar is the same one counterspell-deploy-entry
# enforced for the dedicated host's sudo path.
if [[ $# -eq 0 ]]; then
  request_re='^deploy ([0-9a-f]{40}) (sha256:[0-9a-f]{64}) (sha256:[0-9a-f]{64}) (sha256:[0-9a-f]{64})$'
  req="${SSH_ORIGINAL_COMMAND:-}"
  case "$req" in
    status | rollback)
      set -- "$req"
      ;;
    deploy*)
      if [[ "$req" =~ $request_re ]]; then
        set -- deploy "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}"
      else
        refuse "expected 'deploy <sha> <digest> <digest> <digest>', 'rollback' or 'status'"
      fi
      ;;
    *)
      refuse "expected 'deploy <sha> <digest> <digest> <digest>', 'rollback' or 'status'"
      ;;
  esac
fi

main "$@"
