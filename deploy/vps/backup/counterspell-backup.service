[Unit]
Description=Counterspell nightly encrypted database backup
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/counterspell/backup.env
ExecStart=/usr/local/sbin/counterspell-backup
User=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/counterspell
TimeoutStartSec=45min
