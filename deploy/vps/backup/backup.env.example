# Copy to /etc/counterspell/backup.env on the host (root, mode 0644). Brighton fills it by hand at T28.
# Placeholders only. The Healthchecks ping URLs are not secrets, but anyone who has one can ping it,
# so keep the real values out of git.
AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT
BACKUP_BUCKET=REPLACE_RCLONE_REMOTE:counterspell-backups
RCLONE_CONFIG=/etc/counterspell/rclone.conf
HC_SUCCESS_URL=https://hc-ping.com/REPLACE-SUCCESS-UUID
HC_FAIL_URL=https://hc-ping.com/REPLACE-SUCCESS-UUID/fail
