#!/usr/bin/env bash
# Scans only the commits about to be pushed. Blocks the push only if a secret is found.
GL=$(command -v gitleaks || echo "$HOME/.local/bin/gitleaks")
if [ ! -x "$GL" ]; then
  echo "WARNING: gitleaks not installed; pre-push secret scan skipped (CI will still scan)." >&2
  exit 0
fi
root=$(git rev-parse --show-toplevel)
cfg=(); [ -f "$root/.gitleaks.toml" ] && cfg=(--config "$root/.gitleaks.toml")
zero=0000000000000000000000000000000000000000
status=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue                 # branch deletion
  if [ "$rsha" = "$zero" ]; then range="$lsha --not --remotes"; else range="$rsha..$lsha"; fi
  "$GL" git "${cfg[@]}" --log-opts="$range" --redact --no-banner --exit-code 1 "$root" || status=1
done
[ $status -eq 0 ] || echo "Push blocked: gitleaks found a possible secret. Rotate it, remove it, then push." >&2
exit $status
